[Unit]
Description=Aroma Atelier Telegram Bot
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/atelier/services/telegram-bot
Environment=NODE_ENV=production
EnvironmentFile=/etc/atelier/telegram-bot.env
ExecStart=/usr/bin/node /opt/atelier/services/telegram-bot/dist/index.js
Restart=always
RestartSec=5
User=atelier
Group=atelier

[Install]
WantedBy=multi-user.target
