# Прод-сборка без vite preview (#410): отдаём dist как есть, маршруты SPA — на index.html.
{
	admin off
	auto_https off
}

:4174 {
	root * /srv
	encode zstd gzip

	# Имена в /assets содержат хеш — кэшируем навсегда; index.html и прочее — всегда свежие.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# Фото вкусов (#592): 208 файлов, без хеша в имени, меняются редко. Неделя в кэше
	# без перепроверки, потом ещё сутки старое фото показывается, пока качается новое.
	# Заменённое фото дойдёт до гостя не позже чем через неделю.
	@photos path /photos/*
	header @photos Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
	@other not path /assets/* /photos/*
	header @other Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
