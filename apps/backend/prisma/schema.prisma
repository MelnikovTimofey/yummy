generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IntroCard {
  id          String   @id
  step        Int      @unique
  title       String
  description String
  bullets     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StaffAccount {
  id           String   @id
  login        String   @unique
  passwordHash String
  passwordSalt String
  name         String
  role         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

model DailyAccessCode {
  id        String   @id
  codeValue String
  codeHash  String
  codeSalt  String
  codeLabel String
  active    Boolean  @default(true)
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, startsAt, endsAt])
}

model TelegramRecipient {
  id        String   @id
  chatId    String
  label     String
  scope     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chatId, scope])
  @@index([scope, active])
}

model TelegramOperator {
  id                   String    @id
  name                 String
  phone                String    @unique
  active               Boolean   @default(true)
  linkedChatId         String?   @unique
  linkedTelegramUserId String?
  linkedUsername       String?
  linkedDisplayName    String?
  linkedAt             DateTime?
  lastCodeRequestedAt  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([active])
  @@index([linkedChatId])
}

model TelegramAutomationState {
  id                      String    @id
  lastHeartbeatAt         DateTime?
  lastRotateAt            DateTime?
  lastRotateCodeId        String?
  lastRotateCodeValue     String?
  lastBroadcastAt         DateTime?
  lastBroadcastCodeId     String?
  lastBroadcastCodeValue  String?
  lastBroadcastDayKey     String?
  lastRequestAt           DateTime?
  lastRequestChatId       String?
  lastRequestOperatorId   String?
  lastRequestOperatorName String?
  lastRequestPhone        String?
  lastRequestCodeId       String?
  lastRequestCodeValue    String?
  lastErrorAt             DateTime?
  lastErrorMessage        String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model AuditEvent {
  id          String   @id @default(uuid())
  actorLogin  String
  actorName   String
  actorRole   String
  action      String
  entityType  String
  entityId    String
  entityLabel String
  details     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, createdAt])
  @@index([actorLogin, createdAt])
}

model Tobacco {
  id                String         @id
  manufacturer      String
  lineName          String         @default("")
  name              String
  alias             String?
  description       String?
  sourceKind        String?
  sourceUrl         String?
  sourceExternalId  String?        @unique
  sourceNumericId   String?
  country           String?
  officialStrength  String?
  communityStrength String?
  productionStatus  String?
  imageUrl          String?
  rawSourceTags     String?
  flavorProfiles    String
  flavors           String
  flavorTags        String
  inStock           Boolean        @default(false)
  archived          Boolean        @default(false)
  rating            Float?
  ratingsCount      Int?
  reviewsCount      Int?
  viewsCount        Int?
  statsSyncedAt     DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  mixComponents     MixComponent[]
  shelfItem         ShelfItem?
  supplierItems     SupplierItem[]
  deliveryLines     DeliveryLine[]

  @@unique([sourceKind, sourceNumericId])
  @@index([manufacturer, lineName, name])
  @@index([inStock])
  @@index([archived])
  @@index([sourceKind])
}

model FlavorProfileCatalog {
  key          String   @id
  label        String
  tobaccoCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FlavorCatalog {
  key          String   @id
  label        String
  tobaccoCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FlavorTagCatalog {
  key          String   @id
  label        String
  tobaccoCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SourceTagMapping {
  id                  String   @id
  sourceKind          String
  sourceTag           String
  normalizedSourceTag String
  flavorProfiles      String
  flavors             String
  flavorTags          String
  tobaccoCount        Int      @default(0)
  unmapped            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([sourceKind, normalizedSourceTag])
  @@index([sourceKind])
}

model Mix {
  id             String          @id
  name           String
  description    String
  flavorProfiles String
  flavors        String
  flavorTags     String
  available      Boolean         @default(true)
  baseAvgRating  Float           @default(4.5)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  components     MixComponent[]
  railMixes      RailMix[]
  ratings        MixRating[]
  smokeEvents    SmokeCtaEvent[]
  guestFavorites GuestFavorite[]
}

model MixComponent {
  id         String   @id @default(uuid())
  mixId      String
  tobaccoId  String
  proportion Int      @default(50)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  mix        Mix      @relation(fields: [mixId], references: [id], onDelete: Cascade)
  tobacco    Tobacco  @relation(fields: [tobaccoId], references: [id], onDelete: Restrict)

  @@unique([mixId, tobaccoId])
  @@index([mixId])
  @@index([tobaccoId])
}

model Rail {
  id          String    @id
  name        String
  description String
  type        String
  active      Boolean   @default(true)
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  mixes       RailMix[]

  @@index([type])
  @@index([active])
}

model RailMix {
  id        String   @id @default(uuid())
  railId    String
  mixId     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  rail      Rail     @relation(fields: [railId], references: [id], onDelete: Cascade)
  mix       Mix      @relation(fields: [mixId], references: [id], onDelete: Cascade)

  @@unique([railId, mixId])
  @@index([railId])
  @@index([mixId])
}

// Снимок названия и профилей — чтобы история гостя пережила удаление микса
// мастером (PRD §5.3): mixId тогда становится null, снимок остаётся.
model SmokeCtaEvent {
  id          String        @id @default(uuid())
  mixId       String?
  guestId     String?
  mixName     String
  mixProfiles Json          @default("[]")
  createdAt   DateTime      @default(now())
  mix         Mix?          @relation(fields: [mixId], references: [id], onDelete: SetNull)
  guest       GuestAccount? @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([mixId])
  @@index([guestId, createdAt])
}

// У вошедшего гостя одна оценка на микс (повторная заменяет), у анонимов —
// сколько угодно: NULL в guestId уникальность не нарушает.
model MixRating {
  id        String        @id @default(uuid())
  mixId     String
  guestId   String?
  value     Int
  source    String        @default("guest")
  createdAt DateTime      @default(now())
  mix       Mix           @relation(fields: [mixId], references: [id], onDelete: Cascade)
  guest     GuestAccount? @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@unique([guestId, mixId])
  @@index([mixId])
  @@index([createdAt])
}

// Гостевой микс из «Намиксуй»: снимок состава без FK на Tobacco, чтобы событие
// пережило удаление табака. У вошедшего гостя попадает в его историю (PRD §4
// п. 5); в статистику каталога (SmokeCtaEvent) не попадает.
model CustomMixSmokeEvent {
  id         String          @id @default(uuid())
  guestId    String?
  components Json
  signature  String
  name       String
  harmony    Int
  swipes     Json            @default("[]")
  createdAt  DateTime        @default(now())
  guest      GuestAccount?   @relation(fields: [guestId], references: [id], onDelete: SetNull)
  favorites  GuestFavorite[]

  @@index([signature])
  @@index([createdAt])
  @@index([guestId, createdAt])
}

// Кабинет гостя (#151, PRD §4 п. 4): только Telegram id, согласие и вкусы из
// онбординга. Удаление учётки удаляет избранное, а события и оценки остаются
// в статистике без связи с гостем.
model GuestAccount {
  id                   String                @id @default(uuid())
  telegramId           String                @unique
  consentAt            DateTime
  likedProfiles        Json                  @default("[]")
  likedFlavors         Json                  @default("[]")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  favorites            GuestFavorite[]
  smokeEvents          SmokeCtaEvent[]
  customMixSmokeEvents CustomMixSmokeEvent[]
  ratings              MixRating[]
}

// Одноразовый код входа через бота (#239): сайт создаёт его вместе с согласием
// и вкусами текущего прохождения, бот по /start подтверждает Telegram id, сайт
// забирает токен гостя по статусу. Живёт 10 минут, просроченные чистит старт.
model GuestLoginCode {
  code          String    @id
  consent       Boolean   @default(false)
  likedProfiles Json      @default("[]")
  likedFlavors  Json      @default("[]")
  telegramId    String?
  confirmedAt   DateTime?
  consumedAt    DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
}

// Избранное: каталожный микс (mixId) или собранный в «Намиксуй»
// (customMixEventId), одно из двух — следит код. Снимок названия и профилей
// нужен, когда мастер удалил микс: строка остаётся с «Больше не готовим».
model GuestFavorite {
  id               String               @id @default(uuid())
  guestId          String
  mixId            String?
  customMixEventId String?
  mixName          String
  mixProfiles      Json                 @default("[]")
  createdAt        DateTime             @default(now())
  guest            GuestAccount         @relation(fields: [guestId], references: [id], onDelete: Cascade)
  mix              Mix?                 @relation(fields: [mixId], references: [id], onDelete: SetNull)
  customMixEvent   CustomMixSmokeEvent? @relation(fields: [customMixEventId], references: [id], onDelete: Cascade)

  @@unique([guestId, mixId])
  @@unique([guestId, customMixEventId])
  @@index([guestId, createdAt])
}

// Полка точки (#152): что точка держит. Каталог (Tobacco) о наличии не знает —
// Tobacco.inStock только кэш, который пишет сервис полки (src/shelf.ts).
model ShelfItem {
  id            String       @id @default(uuid())
  tobaccoId     String       @unique
  status        String       @default("active")
  keepStocked   Boolean      @default(true)
  stopped       Boolean      @default(false)
  stopNote      String?
  note          String?
  // Отметка мастера по пробе (#329): yes — зашло, no — не зашло.
  trialVerdict  String?
  trialMarkedAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  tobacco       Tobacco      @relation(fields: [tobaccoId], references: [id], onDelete: Restrict)
  entries       StockEntry[]

  @@index([status])
}

// Журнал остатка табака в граммах (#306): receipt — пришло, count — стало
// («Закончился» — 0 г), writeoff — списано. Расход и прогноз — src/stock.ts.
model StockEntry {
  id             String        @id @default(uuid())
  shelfItemId    String
  kind           String
  grams          Int
  // Отметка долей ¾ ½ ⅓ ¼ от уровня после последнего прихода; grams — во что она превратилась.
  fraction       Float?
  at             DateTime
  // У прихода — цена всего прихода.
  priceKop       Int?
  reason         String?
  deliveryId     String?
  deliveryLineId String?
  actorLogin     String?
  createdAt      DateTime      @default(now())
  shelfItem      ShelfItem     @relation(fields: [shelfItemId], references: [id], onDelete: Restrict)
  delivery       Delivery?     @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  deliveryLine   DeliveryLine? @relation(fields: [deliveryLineId], references: [id], onDelete: SetNull)

  @@index([shelfItemId, at])
  @@index([deliveryId])
  @@index([deliveryLineId])
}

model ShelfSettings {
  id        Int      @id @default(1)
  bowlGrams Int      @default(18)
  leadDays  Int      @default(7)
  // Бюджет на табак в месяц (#326), необязательный.
  budgetKop Int?
  updatedAt DateTime @updatedAt
}

model Supplier {
  id         String         @id @default(uuid())
  name       String
  inn        String?        @unique
  format     String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  items      SupplierItem[]
  deliveries Delivery[]
}

// Память сопоставлений «строка счёта поставщика → табак каталога».
model SupplierItem {
  id             String   @id @default(uuid())
  supplierId     String
  article        String?
  normalizedName String
  tobaccoId      String
  packWeight     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tobacco        Tobacco  @relation(fields: [tobaccoId], references: [id], onDelete: Cascade)

  @@unique([supplierId, normalizedName])
  @@index([supplierId, article])
  @@index([tobaccoId])
}

model Delivery {
  id          String         @id @default(uuid())
  supplierId  String?
  kind        String
  number      String?
  invoiceDate DateTime?
  receivedAt  DateTime?
  status      String         @default("draft")
  totalKop    Int?
  fileName    String?
  file        Bytes?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  supplier    Supplier?      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines       DeliveryLine[]
  entries     StockEntry[]

  @@index([supplierId])
  @@index([status])
}

model DeliveryLine {
  id            String       @id @default(uuid())
  deliveryId    String
  n             Int
  rawName       String
  article       String?
  qty           Int
  unit          String?
  priceKop      Int?
  sumKop        Int?
  grams         Int?
  tobaccoId     String?
  kind          String       @default("tobacco")
  arrived       Boolean      @default(true)
  // Сколько граммов пришло, если мастер поправил; иначе qty × grams.
  receivedGrams Int?
  matchReason   String?
  delivery      Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  tobacco       Tobacco?     @relation(fields: [tobaccoId], references: [id], onDelete: SetNull)
  entries       StockEntry[]

  @@index([deliveryId])
  @@index([tobaccoId])
}
