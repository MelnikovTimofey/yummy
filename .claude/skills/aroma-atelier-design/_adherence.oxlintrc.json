{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/guest/**",
              "components/master/**",
              "ui_kits/aroma-guest/**",
              "ui_kits/master/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Sans|Source Serif 4|Gelasio|Mulish))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Sans, Source Serif 4, Gelasio, Mulish."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccessCodeInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|label|hint|maxLength|id|key|ref|className|style|children)$/]",
        "message": "<AccessCodeInput> doesn't accept that prop. Declared props: value, onChange, label, hint, maxLength, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='AromaChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tier|active|profile|color|onClick|disabled|type|style|key|ref|className|style|children)$/]",
        "message": "<AromaChip> doesn't accept that prop. Declared props: children, tier, active, profile, color, onClick, disabled, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AromaChip'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:lg|sm)$/]",
        "message": "<AromaChip> tier must be one of 'lg' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AromaChip'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<AromaChip> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AromaCTA'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|disabled|pulse|type|style|key|ref|className|style|children)$/]",
        "message": "<AromaCTA> doesn't accept that prop. Declared props: children, onClick, disabled, pulse, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AromaCTA'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<AromaCTA> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MixComponentItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|manufacturer|proportion|key|ref|className|style|children)$/]",
        "message": "<MixComponentItem> doesn't accept that prop. Declared props: id, name, manufacturer, proportion."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|count|onClick|style|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: children, active, count, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GuestCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|compact|title|style|key|ref|className|style|children)$/]",
        "message": "<GuestCard> doesn't accept that prop. Declared props: children, compact, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GuestTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|onClick|style|key|ref|className|style|children)$/]",
        "message": "<GuestTab> doesn't accept that prop. Declared props: children, active, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MasterButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|onClick|type|icon|style|key|ref|className|style|children)$/]",
        "message": "<MasterButton> doesn't accept that prop. Declared props: children, variant, size, disabled, onClick, type, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MasterButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|primary|ghost|danger)$/]",
        "message": "<MasterButton> variant must be one of 'default' | 'primary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MasterButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<MasterButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MasterButton'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<MasterButton> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MasterCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|eyebrow|heading|actions|style|key|ref|className|style|children)$/]",
        "message": "<MasterCard> doesn't accept that prop. Declared props: children, eyebrow, heading, actions, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MasterIconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|small|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<MasterIconButton> doesn't accept that prop. Declared props: children, label, small, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MasterInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|icon|size|type|disabled|id|style|key|ref|className|style|children)$/]",
        "message": "<MasterInput> doesn't accept that prop. Declared props: value, onChange, placeholder, icon, size, type, disabled, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MasterInput'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg|xl)$/]",
        "message": "<MasterInput> size must be one of 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MasterListColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|width|align|wrap|render|key|ref|className|style|children)$/]",
        "message": "<MasterListColumn> doesn't accept that prop. Declared props: key, label, width, align, wrap, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='MasterListColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<MasterListColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MasterPageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|subtitle|actions|meta|style|key|ref|className|style|children)$/]",
        "message": "<MasterPageHeader> doesn't accept that prop. Declared props: eyebrow, title, subtitle, actions, meta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MasterSortOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|key|ref|className|style|children)$/]",
        "message": "<MasterSortOption> doesn't accept that prop. Declared props: key, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='MasterStatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|hint|tone|key|ref|className|style|children)$/]",
        "message": "<MasterStatTile> doesn't accept that prop. Declared props: label, value, hint, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='MasterStatTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|success|warning|danger|code)$/]",
        "message": "<MasterStatTile> tone must be one of 'default' | 'success' | 'warning' | 'danger' | 'code'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MasterTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|dot|style|key|ref|className|style|children)$/]",
        "message": "<MasterTag> doesn't accept that prop. Declared props: children, tone, dot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MasterTag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|info|success|warning|accent|danger|ghost)$/]",
        "message": "<MasterTag> tone must be one of 'neutral' | 'info' | 'success' | 'warning' | 'accent' | 'danger' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MasterToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|style|key|ref|className|style|children)$/]",
        "message": "<MasterToggle> doesn't accept that prop. Declared props: checked, onChange, label, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MasterTopBarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<MasterTopBarItem> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='MixRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|flavors|profiles|rating|glyphSize|showGlyph|showSignature|onClick|style|key|ref|className|style|children)$/]",
        "message": "<MixRow> doesn't accept that prop. Declared props: name, flavors, profiles, rating, glyphSize, showGlyph, showSignature, onClick, style."
