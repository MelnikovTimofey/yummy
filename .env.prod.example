# Образец прод-окружения для docker-compose.prod.yml.
# Скопировать в .env на сервере, заполнить, выставить права: chmod 600 .env
# НЕ коммитить заполненный .env. Полная матрица — docs/atelier/env-matrix.md.

# --- Домены (Caddy + зашиваются в бандлы фронтов на build) ---
AROMA_DOMAIN=atelier.example.com
MASTER_DOMAIN=master.atelier.example.com
API_DOMAIN=api.atelier.example.com
# Email для ACME/Let's Encrypt уведомлений
ACME_EMAIL=ops@example.com
# Публичный URL backend — зашивается в оба фронта (build-arg VITE_API_BASE_URL).
# Обычно https://${API_DOMAIN}. При смене нужен пересбор фронтов (--build).
PUBLIC_API_URL=https://api.atelier.example.com

# --- Backend ---
# Пароль Postgres контура (сервис db). DATABASE_URL для backend compose собирает сам.
# Только URL-безопасные символы: openssl rand -hex 32
POSTGRES_PASSWORD=
# Сгенерировать: openssl rand -hex 32 (независимые значения!)
ATELIER_AUTOMATION_KEY=
ATELIER_TOKEN_SECRET=
ATELIER_TOKEN_TTL_HOURS=24

# --- Telegram-бот ---
# Токен от @BotFather. ATELIER_BACKEND_AUTOMATION_TOKEN боту не задаём отдельно —
# compose подставляет в него ATELIER_AUTOMATION_KEY (должны совпадать).
TELEGRAM_BOT_TOKEN=

# --- Туннель до Telegram (только для хостов без IPv6, см. runbook §4) ---
# COMPOSE_PROFILES=tg-tunnel
# TG_TUNNEL_TARGET=tgtunnel@<хост-вне-РФ>
# TG_TUNNEL_PORT=22
# Ключ и known_hosts кладутся в secrets/telegram-tunnel/ (id_ed25519, known_hosts).

# --- Bootstrap первого admin (одноразово, см. runbook; можно НЕ держать в .env) ---
# ATELIER_BOOTSTRAP_ADMIN_LOGIN=atelier-admin
# ATELIER_BOOTSTRAP_ADMIN_NAME=Ателье Admin
# ATELIER_BOOTSTRAP_ADMIN_PASSWORD=
